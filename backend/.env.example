# ---------------------------------------------------
# Server Configuration
# ---------------------------------------------------
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000   # Change in production

# ---------------------------------------------------
# Database Configuration
# ---------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/bus_booking_system
# For production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Cluster0

# ---------------------------------------------------
# JWT Configuration
# ---------------------------------------------------
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=7d

# ---------------------------------------------------
# Admin Credentials
# ---------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@busbooking.com

# ---------------------------------------------------
# Email Configuration (SMTP / Gmail App Password)
# ---------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# ---------------------------------------------------
# Company Information
# ---------------------------------------------------
COMPANY_NAME="Your Company Name"
COMPANY_EMAIL=support@yourcompany.com
SUPPORT_EMAIL=support@yourcompany.com
COMPANY_PHONE=+1-800-123-4567
COMPANY_WEBSITE=https://yourcompany.com

# ---------------------------------------------------
# File Upload Configuration
# ---------------------------------------------------
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ---------------------------------------------------
# CORS Configuration
# ---------------------------------------------------
FRONTEND_URL=http://localhost:5173   # Replace with production frontend
